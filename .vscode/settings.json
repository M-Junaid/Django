{
  "files.associations": {
    "*.html": "django-html"
  },
  "emmet.includeLanguages": {
    "django-html": "html"
  },
  "html.suggest.html5": true,
  "html.format.templating": "django",
  "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": true
  },
  "[django-html]": {
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true
    },
    "editor.suggest.showWords": true,
    "editor.suggest.showSnippets": true
  }
}
